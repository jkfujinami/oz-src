{
  "name": "@oz/guard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "\u30d8\u30c3\u30c9\u30ec\u30b9\u306e\u4fe1\u983c Guard (Node.js + node-datachannel)",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/main.mjs --log-level=warning --external:node-datachannel --external:ws --external:fake-indexeddb --external:libsodium-wrappers-sumo --external:idb --external:@msgpack/msgpack",
    "start": "npm run build --silent && node dist/main.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oz/core": "*",
    "fake-indexeddb": "^6.2.5",
    "node-datachannel": "0.33.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@oz/tracker": "*",
    "@types/node": "^20",
    "@types/ws": "^8.18.1",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "esbuild": "^0.28.2"
  }
}
