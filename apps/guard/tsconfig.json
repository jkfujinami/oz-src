{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": false,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@oz/core": [
        "../../packages/core/src/index.ts"
      ],
      "@oz/tracker": [
        "../../packages/tracker/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
